# Django
DJANGO_SECRET_KEY=your-secret-key-here
DEBUG=1

# Database
DB_NAME=voevoda
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Frontend
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Синхронизация админка -> портал ---
# Локально работает из коробки (dev-эндпоинт /__admin-sync в vite портала).
# Для продакшена (Vercel):
#  1) В проекте ПОРТАЛА на Vercel: Storage -> Create -> Blob (появится BLOB_READ_WRITE_TOKEN).
#  2) В проекте ПОРТАЛА добавить env: ADMIN_SYNC_SECRET=<любая длинная случайная строка>
#  3) В проекте АДМИНКИ добавить env: VITE_ADMIN_SYNC_SECRET=<та же строка>
#     и VITE_PORTAL_URL=<адрес портала>, затем передеплоить оба проекта.
# Серверный секрет портала (проверяется функцией /api/admin-sync):
ADMIN_SYNC_SECRET=
# Админка (билд-переменные Vite):
VITE_PORTAL_URL=https://portal-seven-silk.vercel.app/
VITE_ADMIN_SYNC_SECRET=
# Переопределение адресов эндпоинтов (обычно не нужно):
VITE_ADMIN_SYNC_URL=
VITE_ADMIN_IMAGES_URL=

# JSONBin (опциональный запасной канал синхронизации, можно не заполнять)
VITE_JSONBIN_BIN_ID=
VITE_JSONBIN_API_KEY=

# YooKassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_WEBHOOK_SECRET=
YOOKASSA_RECEIPTS_ENABLED=0
YOOKASSA_DEFAULT_VAT_CODE=1

# AWS S3 / R2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=voevoda-media
AWS_S3_ENDPOINT_URL=https://s3.amazonaws.com
